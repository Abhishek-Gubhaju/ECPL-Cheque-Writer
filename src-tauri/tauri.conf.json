{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "ECPL Cheque Writer",
  "version": "1.0.0",
  "identifier": "com.ecpl.cheque-writer",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ECPL Cheque Writer",
        "width": 580,
        "height": 649,
        "minWidth": 500,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "devtools": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/AppIcon.png",
      "icons/AppIcon.icns",
      "icons/icon.ico",
      "icons/app-icon.svg"
    ]
  }
}